{
  "manifest_version": 3,
  "name": "FortiFlex API Connector",
  "version": "0.1.4",
  "description": "Connects the FabricBOM FortiFlex calculator directly to Fortinet using browser-local credentials.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://customerapiauth.fortinet.com/*",
    "https://support.fortinet.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "FortiFlex API Connector",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://msalty.github.io/FabricBOM/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
