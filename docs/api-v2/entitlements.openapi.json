                "requestBody": {
                    "content": {
                        "application\/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "configId": {
                                        "type": "integer"
                                    },
                                    "count": {
                                        "type": "integer"
                                    },
                                    "description": {
                                        "type": "string"
                                    },
                                    "endDate": {
                                        "type": "string",
                                        "format": "date-time"
                                    },
                                    "folderPath": {
                                        "type": "string"
                                    },
                                    "skipPending": {
                                        "type": "boolean"
                                    }
                                },
                                "example": {
                                    "configId": 22,
                                    "count": 3,
                                    "description": "VMs created for department Z",
                                    "endDate": "2021-10-11 00:00:00",
                                    "folderPath": "My Assets\/subfolder1",
                                    "skipPending": false
                                }
                            }
                        }
                    },
                    "description": "1. By using 'endDate': null it will use the Program's end date automatically.\n 2. Set 'skipPending' to true will activate the entitlement right away and charges start to incur even without downloading the license by token."
