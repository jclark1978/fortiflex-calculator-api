            "post": {
                "tags": [
                    "Entitlements"
                ],
                "summary": "Get list of existing entitlements for a Configuration",
                "operationId": "GetVMListRequest",
                "description": "Either configId or (accountId + programSerialNumber) should be provided in request payload.",
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "allOf": [
                                        {
                                            "$ref": "#\/definitions\/commonResponseFields"
                                        },
                                        {
                                            "$ref": "#\/definitions\/entitlementsArray"
                                        }
                                    ],
                                    "example": {
                                        "status": 0,
                                        "message": "Request processed successfully",
                                        "error": null,
                                        "entitlements": [
                                            {
                                                "serialNumber": "FGVMELTM20000004",
                                                "description": "VM created for department X",
                                                "configId": 22,
                                                "accountId": 12345,
                                                "startDate": "2020-08-25 10:12:25",
                                                "endDate": "2020-09-12 12:13:37",
                                                "status": "STOPPED",
                                                "token": "07981E8F70FFB1281179",
                                                "tokenStatus": "USED"
                                            },
                                            {
                                                "serialNumber": "FGVMELTM20000015",
                                                "description": "VM created for department Y",
                                                "configId": 22,
                                                "accountId": 12345,
                                                "startDate": "2021-01-01 00:00:00",
                                                "endDate": "2022-10-21 12:13:37",
                                                "status": "ACTIVE",
                                                "token": "445A30CE1A88D8426119",
                                                "tokenStatus": "NOTUSED"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                },
                "requestBody": {
                    "content": {
                        "application\/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "configId": {
                                        "type": "integer"
                                    },
                                    "programSerialNumber": {
                                        "type": "string"
                                    },
                                    "accountId": {
                                        "type": "integer"
                                    },
                                    "serialNumber": {
                                        "type": "string"
                                    },
