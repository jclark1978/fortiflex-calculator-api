    "paths": {
        "\/configs\/list": {
            "post": {
                "tags": [
                    "Configurations"
                ],
                "summary": "Get list of Configurations for a Program",
                "operationId": "GetConfigListRequest",
                "description": "accountId in request payload is optional. When not provided, the API returns all Configurations of all tenant accounts under the organization (program serial number registered to root account).",
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "allOf": [
                                        {
                                            "$ref": "#\/definitions\/commonResponseFields"
                                        },
                                        {
                                            "$ref": "#\/definitions\/configsArray"
                                        }
                                    ],
                                    "example": {
                                        "status": 0,
                                        "message": "Request processed successfully",
                                        "error": null,
                                        "configs": [
                                            {
                                                "id": 21,
                                                "name": "Configuration Name",
                                                "programSerialNumber": "ELAVMR0000000101",
                                                "accountId": 12345,
                                                "status": "ACTIVE",
                                                "productType": {
                                                    "id": 1,
                                                    "name": "FortiGate VM"
                                                },
                                                "parameters": [
                                                    {
                                                        "id": 1,
                                                        "name": "CPU",
                                                        "value": "4"
                                                    },
                                                    {
                                                        "id": 2,
                                                        "name": "SERVICEPACK",
                                                        "value": "UTM"
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                },
                "requestBody": {
                    "content": {
                        "application\/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "programSerialNumber": {
                                        "type": "string"
                                    },
                                    "accountId": {
                                        "type": "integer"
                                    }
                                },
                                "example": {
                                    "programSerialNumber": "ELAVMR0000000101",
                                    "accountId": 12345
                                }
                            }
                        }
                    },
                    "description": ""
                }
            }
        },
