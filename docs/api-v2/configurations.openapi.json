                                    "name": {
                                        "type": "string"
                                    },
                                    "productTypeId": {
                                        "type": "integer"
                                    },
                                    "parameters": {
                                        "$ref": "#\/definitions\/paramsArray"
                                    }
                                },
                                "example": {
                                    "programSerialNumber": "ELAVMR0000000101",
                                    "accountId": 12345,
                                    "name": "Test Configuration",
                                    "productTypeId": 1,
                                    "parameters": [
                                        {
                                            "id": 1,
                                            "value": "4"
                                        },
